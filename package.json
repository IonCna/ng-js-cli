{
  "name": "ng-js-cli",
  "version": "0.1.0",
  "description": "CLI de build/dev para proyectos ngjs-core — SWC para decoradores, esbuild para build, Vite (ng-js-vite) para dev-server.",
  "type": "module",
  "private": true,
  "bin": {
    "ngjs": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@swc/core": "^1.16.2",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1",
    "ng-js-vite": "link:ng-js-vite"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
