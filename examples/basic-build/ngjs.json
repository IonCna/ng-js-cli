{
  "version": "1",
  "root": ".",
  "projectType": "library",
  "sourceRoot": "src",
  "architect": {
    "build": {
      "options": {
        "entryPoints": { "index": "src/index.ts" },
        "outputPath": "dist",
        "sourceMap": true,
        "declarations": true,
        "external": ["ngjs-core", "angular"]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "sourceMap": false,
          "fileReplacements": [{ "replace": "src/environment.ts", "with": "src/environment.prod.ts" }]
        }
      }
    }
  }
}
